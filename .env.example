# ---------------------------------------------------------------------------
# ARKSOME environment variables
# Copy this file to .env.local and fill in real values.
# Never commit real credentials. Never prefix server secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Must NEVER be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional integrations (add only when implemented) ---
# Google Ad Manager / Publisher Tag
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Base URL used for absolute links (production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project reference for `supabase link` (not exposed to the browser)
# SUPABASE_PROJECT_REF=
